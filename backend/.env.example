# GreenNiche backend environment variables.
# Copy to .env and fill in. NEVER commit the real .env file.

# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Example: postgresql://user:password@localhost:5432/greenniche
DATABASE_URL="postgresql://user:password@localhost:5432/greenniche"

# ---- Auth ----
# Generate a long random string. Used to sign JWTs.
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# ---- Paystack (Ghana) ----
# Use TEST keys during development. Keep secret keys server-side only.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-secret"
PAYSTACK_CURRENCY="GHS"

# ---- Notifications ----
# When a provider is not configured, the app runs in DEV mode (logs to DB, no real send).
NOTIFICATIONS_DEV_MODE=true

# WhatsApp (via Meta Cloud API or a provider like Twilio)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_FROM_NUMBER=""

# SMS (Hubtel or Twilio). Choose one provider.
SMS_PROVIDER=""
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""
HUBTEL_SENDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Email
EMAIL_PROVIDER=""
EMAIL_FROM="GreenNiche Enterprise <no-reply@greenniche.example>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# ---- Business settings ----
BUSINESS_NAME="GreenNiche Enterprise"
BUSINESS_PHONE="0256673127"
BUSINESS_EMAIL="clementkwasiannan01@gmail.com"
# Address is configurable pending confirmation (Old Ebu vs Abuenu, Central Region, Ghana).
BUSINESS_LOCATION="Central Region, Ghana"
BUSINESS_TAGLINE="Zero Waste. Full Value. Processing the Future."
