// GreenNiche Enterprise — Prisma schema (Phase 1 core models)
// Money is stored as Decimal (never float). Statuses are explicit enums.
// Phase 2 models (ProductionCycle, Supplier, Purchase, Expense, Invoice, Loyalty)
// are listed as stubs at the bottom and will be fleshed out in Phase 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  OPERATIONS
  FINANCE
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CustomerType {
  INDIVIDUAL
  VENDOR
  SCHOOL
  INSTITUTION
}

enum OrderStatus {
  NEW
  RECEIVED
  PROCESSING
  READY
  DELIVERED
  CANCELLED
}

enum OrderChannel {
  GUEST
  REGISTERED
}

enum PaymentMethod {
  PAYSTACK
  CASH_ON_DELIVERY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  MANUAL
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum StockMovementType {
  INTAKE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DEDUCTION
  RESERVATION
  RESERVATION_RELEASE
  PRODUCTION_OUTPUT
  WASTAGE
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GalleryImageStatus {
  DRAFT
  PUBLISHED
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum ContactEnquiryStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Auth & users
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  phone           String?    @unique
  fullName        String
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  passwordHash    String
  twoFactorSecret String? // base32 secret for TOTP; null = 2FA not enabled
  twoFactorEnabled Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  customerProfile CustomerProfile?

  @@index([role])
}

model CustomerProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerType    CustomerType @default(INDIVIDUAL)
  // Total verified spending (sum of successful payments). Maintained transactionally.
  totalSpent      Decimal      @default(0) @db.Decimal(12, 2)
  ordersCount     Int          @default(0)
  notes           String?
  marketingConsent Boolean      @default(false)
  birthday        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  addresses Address[]
  orders    Order[]
  carts     Cart[]

  @@index([customerType])
}

model Address {
  id              String   @id @default(cuid())
  customerProfileId String
  customerProfile  CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  label           String   @default("Home") // e.g. Home, Work, Market
  recipientName   String
  phone           String
  region          String
  city            String
  area            String?
  landmark        String?
  deliveryInstructions String?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerProfileId])
}

// ---------------------------------------------------------------------------
// Catalogue: categories, products, variants, images, inventory
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  summary         String
  description     String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  // Null price => "Price on request". When set, the server is authoritative.
  basePrice       Decimal? @db.Decimal(12, 2)
  priceVisible    Boolean  @default(true) // public price vs price-on-request
  canOrderOnline  Boolean  @default(true)
  minOrderQty     Int      @default(1)
  unit            String?  // e.g. "pack", "bag", "kg"
  // Convenience stock snapshot; the inventory model is the source of truth.
  isActive        Boolean  @default(true)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants        ProductVariant[]
  images          ProductImage[]
  inventory       Inventory?
  cartItems       CartItem[]
  orderItems      OrderItem[]
  stockMovements  StockMovement[]

  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String   // e.g. "1kg pack", "5kg bag"
  sku         String?  @unique
  priceDelta  Decimal  @default(0) @db.Decimal(12, 2)
  weight      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  caption   String?
  position  Int     @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Inventory {
  id              String  @id @default(cuid())
  productId       String  @unique
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // onHand = physical units present. reserved = units tied to unpaid orders.
  // available = onHand - reserved (computed; kept consistent transactionally).
  onHand          Int     @default(0)
  reserved        Int     @default(0)
  minThreshold    Int     @default(0)
  reorderLevel    Int     @default(0)
  updatedAt       DateTime @updatedAt

  movements StockMovement[]
}

model StockMovement {
  id            String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  inventoryId    String?
  inventory      Inventory?        @relation(fields: [inventoryId], references: [id])
  type           StockMovementType
  quantity       Int              // signed by type semantics; positive for additions, negative for deductions
  referenceType  String?          // 'Order' | 'ProductionCycle' | 'Adjustment' | ...
  referenceId    String?
  userId         String?          // who performed it
  notes          String?
  createdAt      DateTime         @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(cuid())
  // Either a logged-in customer or a guest token (random) stored client-side.
  customerProfileId String?
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  guestToken String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt

  items CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int
  unitPrice Decimal       @db.Decimal(12, 2) // snapshot at add time; server recomputes on checkout
  createdAt DateTime      @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, productId, variantId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id              String        @id @default(cuid())
  reference       String        @unique // human-friendly, e.g. GN-20261018-AB12
  channel         OrderChannel  @default(GUEST)
  customerProfileId String?
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  // Snapshot of customer info for guest orders and history accuracy.
  customerName    String
  customerPhone   String
  customerEmail   String?
  recipientName   String
  recipientPhone  String
  region          String
  city            String
  area            String?
  landmark        String?
  deliveryInstructions String?
  subtotal        Decimal       @db.Decimal(12, 2)
  deliveryFee     Decimal       @default(0) @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  status          OrderStatus   @default(NEW)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(PAYSTACK)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items    OrderItem[]
  payments Payment[]
  delivery Delivery?

  @@index([customerProfileId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name       String          // snapshot
  unitPrice  Decimal         @db.Decimal(12, 2) // snapshot
  quantity   Int
  lineTotal  Decimal         @db.Decimal(12, 2)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Payments (Paystack) and delivery
// ---------------------------------------------------------------------------

model Payment {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        PaymentProvider @default(PAYSTACK)
  providerRef     String?         @unique // Paystack reference
  accessCode      String?
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("GHS")
  status          PaymentStatus   @default(PENDING)
  paidAt          DateTime?
  providerPayload Json?           // raw verified response (no secrets)
  failReason      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orderId])
  @@index([providerRef])
}

model DeliveryZone {
  id            String   @id @default(cuid())
  name          String   @unique // e.g. "Cape Coast", "Old Ebu"
  regions       String[] // array of region/area tags matched at checkout
  fee           Decimal  @db.Decimal(12, 2)
  estimatedDays String?  // e.g. "1-2 days"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deliveries    Delivery[]
}

model Delivery {
  id           String          @id @default(cuid())
  orderId      String          @unique
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  zoneId       String?
  zone         DeliveryZone?   @relation(fields: [zoneId], references: [id])
  status       DeliveryStatus  @default(PENDING)
  driverName   String?
  driverPhone  String?
  trackingNote String?
  proofPhotoUrl String?
  confirmedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Content & comms (public site + admin)
// ---------------------------------------------------------------------------

model BlogCategory {
  id    String    @id @default(cuid())
  slug  String    @unique
  name  String
  posts BlogPost[]
}

model BlogPost {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  excerpt     String?
  content     String
  seoTitle    String?
  seoDescription String?
  featuredImageUrl String?
  status      BlogPostStatus  @default(DRAFT)
  publishedAt DateTime?
  authorId    String?
  categoryId  String?
  category    BlogCategory?   @relation(fields: [categoryId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model GalleryImage {
  id        String             @id @default(cuid())
  title     String?
  url       String
  altText   String?
  caption   String?
  tag       String? // e.g. "gari", "production", "awards"
  status    GalleryImageStatus @default(PUBLISHED)
  position  Int    @default(0)
  createdAt DateTime @default(now())

  @@index([status])
}

model Testimonial {
  id        String   @id @default(cuid())
  // Empty by default; the public section is hidden until a genuine testimonial exists.
  authorName String
  authorRole String?
  content   String
  rating    Int      @default(5)
  isPublished Boolean @default(false)
  source    String?  // e.g. "order: <id>"
  createdAt DateTime @default(now())

  @@index([isPublished])
}

model ContactEnquiry {
  id        String              @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  status    ContactEnquiryStatus @default(NEW)
  adminReply String?
  createdAt DateTime            @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status])
}

model NotificationTemplate {
  id        String @id @default(cuid())
  key       String @unique // e.g. "order.confirmation"
  channel   NotificationChannel
  subject   String?
  body      String // handlebars-style placeholders
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String             @id @default(cuid())
  channel   NotificationChannel
  templateKey String?
  recipient String // phone or email
  subject   String?
  body      String
  status    NotificationStatus @default(QUEUED)
  providerMessageId String?
  error     String?
  attempts  Int      @default(0)
  sentAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([recipient])
}

// ---------------------------------------------------------------------------
// Settings, audit log
// ---------------------------------------------------------------------------

model BusinessSetting {
  id    String   @id @default(cuid())
  key   String   @unique
  value String
  notes String?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // e.g. "order.status_changed"
  entity    String?
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

